{
  "name": "@mydaogs/web3",
  "version": "0.6.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mydaogs/kit.git",
    "directory": "packages/web3"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "description": "Isomorphic web3 config: env-driven chain resolution, bytes32 helpers, explorer URLs, revert decoding",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "*.md"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "viem": "^2.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "viem": "2.21.0",
    "zod": "3.24.0"
  }
}
