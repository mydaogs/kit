{
  "name": "@mydaogs/web3-client",
  "version": "0.2.8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mydaogs/kit.git",
    "directory": "packages/web3-client"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "description": "React client layer for @mydaogs/web3-tx: contract-write wrapper and pending-transaction scope selector",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "*.md"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "viem": "^2.0.0",
    "wagmi": "^2.0.0"
  },
  "dependencies": {
    "@mydaogs/core": "workspace:*",
    "@mydaogs/web3": "workspace:*",
    "@mydaogs/web3-tx": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.62.0",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "viem": "2.21.0",
    "wagmi": "2.14.0"
  }
}
