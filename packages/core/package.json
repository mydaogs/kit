{
  "name": "@mydaogs/core",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mydaogs/kit.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "description": "Zero-dependency isomorphic primitives: bigint JSON wire protocol, typed route paths, type helpers",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "compile": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm compile"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
