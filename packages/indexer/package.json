{
  "name": "@mydaogs/indexer",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mydaogs/kit.git",
    "directory": "packages/indexer"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "description": "Storage-agnostic onchain event projection: atomic claim, capped backoff, ordering watermarks, terminal-failure taxonomy",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "dependencies": {
    "@mydaogs/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
