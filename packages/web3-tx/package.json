{
  "name": "@mydaogs/web3-tx",
  "version": "0.2.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mydaogs/kit.git",
    "directory": "packages/web3-tx"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "description": "Durable pending-transaction registry: cross-tab ownership, reconciliation, and failure recovery, with no React in the graph",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "*.md"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0"
  },
  "dependencies": {
    "@mydaogs/contract": "workspace:*",
    "@mydaogs/core": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.62.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
