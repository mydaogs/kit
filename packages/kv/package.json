{
  "name": "@mydaogs/kv",
  "version": "0.6.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mydaogs/kit.git",
    "directory": "packages/kv"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./rest": {
        "types": "./dist/rest.d.ts",
        "import": "./dist/rest.js",
        "default": "./dist/rest.js"
      }
    }
  },
  "type": "module",
  "description": "Shared Redis client with lazy env resolution, safe to load inside Next runtime infrastructure",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./rest": "./src/rest.ts"
  },
  "files": [
    "dist",
    "*.md"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@upstash/redis": "^1.36.0"
  },
  "devDependencies": {
    "@upstash/redis": "1.36.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "server-only": "^0.0.1"
  }
}
