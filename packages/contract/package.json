{
  "name": "@mydaogs/contract",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mydaogs/kit.git",
    "directory": "packages/contract"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "description": "Versioned backend wire contract: response envelope, error catalog, credential-free public lane, build-time version probe",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "check:contract-hygiene": "! grep -rnE '@mydaogs/(kv|cache-handler|indexer)|prisma' src/ 2>/dev/null",
    "lint": "eslint src --max-warnings 0",
    "compile": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm compile"
  },
  "dependencies": {
    "@mydaogs/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
