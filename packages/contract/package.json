{
  "name": "@kit/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned backend wire contract: response envelope, error catalog, credential-free public lane, build-time version probe",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "check:contract-hygiene": "! grep -rnE '@kit/(kv|cache-handler|indexer)|prisma' src/ 2>/dev/null",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@kit/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
