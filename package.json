{
  "name": "@kit/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Portable package kit for Next.js + web3 projects",
  "scripts": {
    "check-types": "pnpm -r check-types",
    "lint": "pnpm -r lint",
    "check:cache-handlers": "node scripts/check-cache-handlers.mjs",
    "check:bare-revalidate": "node scripts/check-no-bare-revalidate.mjs",
    "verify": "tsx scripts/smoke.ts",
    "check": "pnpm check-types && pnpm verify && pnpm check:cache-handlers"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.62.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@upstash/redis": "1.36.2",
    "react": "^19.2.8",
    "server-only": "0.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "viem": "2.21.0",
    "wagmi": "2.14.0",
    "zod": "3.24.0"
  },
  "dependencies": {
    "@kit/cache-handler": "workspace:*",
    "@kit/contract": "workspace:*",
    "@kit/core": "workspace:*",
    "@kit/indexer": "workspace:*"
  }
}
